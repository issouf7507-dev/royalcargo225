// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}




model Adresse {
  id        String   @id @default(uuid())
  nom       String
  tel       String
  email     String? @unique
  pays      Pays
  type      String
  poids     Float?
  volume    Float?
  prix      Float?
  status    String
  date      DateTime?
  description String
  images      Image[]  // 🔁 Relation à plusieurs images
  etat      String?
  codeTracking String? @unique
  service   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id          String    @id @default(uuid())
  url         String
  description String?
  adresseId   String?   // FK vers Adresse
  adresse     Adresse?  @relation(fields: [adresseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}



model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Pays {
  COTE_D_IVOIRE
  MALI
}